# VoxText environment template.
# Copy to .env and adjust.  Anything left unset falls back to a safe default
# for local development (see app/config.py).

# --- Runtime ------------------------------------------------------------------
DEBUG=true

# --- Security -----------------------------------------------------------------
# REQUIRED when DEBUG=false.  Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# While DEBUG=true a throw-away key is generated into instance/ automatically.
SECRET_KEY=
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# --- Database -----------------------------------------------------------------
# SQLite is fine for development; PostgreSQL needs no code change, only this URL.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/voxtext
DATABASE_URL=sqlite:///./voxtext.db

# --- Speech to text -----------------------------------------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# Load the model at start-up instead of on the first request.
WHISPER_WARM_ON_STARTUP=true
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
# ALLOWED_AUDIO_EXTENSIONS=[".webm",".wav",".mp3",".m4a",".ogg",".opus"]

# --- CORS (only needed if the frontend is served from another origin) ---------
# CORS_ORIGINS=["https://app.example.com"]
